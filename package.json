{
  "name": "snaplab-ng",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @snaplab/web --filter @snaplab/api dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '@snaplab/*' typecheck",
    "lint": "biome check .",
    "test": "bun run --filter '@snaplab/*' test",
    "build": "bun run --filter '@snaplab/*' build",
    "shot": "bun scripts/shot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
