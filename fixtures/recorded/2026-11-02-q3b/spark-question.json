          {
            "type": "output_text",
            "text": "{\"apparatus\": [{\"kind\": \"ammeter\", \"text_as_printed\": \"an ammeter\"}, {\"kind\": \"voltmeter\", \"text_as_printed\": \"a voltmeter\"}, {\"kind\": \"resistance_box\", \"text_as_printed\": \"a resistance box\"}, {\"kind\": \"connecting_wires\", \"text_as_printed\": \"connecting wires\"}, {\"kind\": \"cells\", \"text_as_printed\": \"dry cells\"}, {\"kind\": \"other\", \"text_as_printed\": \"other necessary materials\"}], \"confidence\": \"high\", \"diagram\": {\"parts\": [{\"box\": {\"x0\": 0.175, \"x1\": 0.315, \"y0\": 0.195, \"y1\": 0.355}, \"kind\": \"resistance_box\", \"label_as_printed\": \"R\"}, {\"box\": {\"x0\": 0.35, \"x1\": 0.465, \"y0\": 0.235, \"y1\": 0.33}, \"kind\": \"ammeter\", \"label_as_printed\": \"A\"}, {\"box\": {\"x0\": 0.52, \"x1\": 0.595, \"y0\": 0.195, \"y1\": 0.32}, \"kind\": \"key\", \"label_as_printed\": \"K\"}, {\"box\": {\"x0\": 0.665, \"x1\": 0.77, \"y0\": 0.185, \"y1\": 0.325}, \"kind\": \"cells\", \"label_as_printed\": \"E\"}, {\"box\": {\"x0\": 0.23, \"x1\": 0.275, \"y0\": 0.54, \"y1\": 0.64}, \"kind\": \"wire_xy\", \"label_as_printed\": \"X\"}, {\"box\": {\"x0\": 0.73, \"x1\": 0.775, \"y0\": 0.54, \"y1\": 0.64}, \"kind\": \"wire_xy\", \"label_as_printed\": \"Y\"}, {\"box\": {\"x0\": 0.465, \"x1\": 0.56, \"y0\": 0.685, \"y1\": 0.79}, \"kind\": \"voltmeter\", \"label_as_printed\": \"V\"}], \"photo\": 1, \"present\": true}, \"experiment\": \"ohms_law_vi\", \"instructions\": [{\"label\": \"1\", \"text\": \"You are provided with an ammeter, a voltmeter, a resistance box, connecting wires, dry cells and other necessary materials.\"}, {\"label\": \"2\", \"text\": \"Measure and record the length XY of the resistance wire provided.\"}, {\"label\": \"3\", \"text\": \"Connect the circuit as shown in the diagram.\"}, {\"label\": \"4\", \"text\": \"With R = 0 \\u03a9, close the key K. Read and record the current I and the corresponding voltage drop V across the wire.\"}, {\"label\": \"5\", \"text\": \"Set R = 1 \\u03a9, close the key, read and record I and V.\"}, {\"label\": \"6\", \"text\": \"Repeat for five other values of R = 5, 10, 20, 40 and 60 \\u03a9. Tabulate.\"}, {\"label\": \"7\", \"text\": \"Plot V (vertical) against I (horizontal).\"}, {\"label\": \"8\", \"text\": \"Determine the slope s.\"}, {\"label\": \"9\", \"text\": \"State two precautions.\"}, {\"label\": \"(b)(i)\", \"text\": \"Mention and state the law on which the experiment is based.\"}, {\"label\": \"(b)(ii)\", \"text\": \"A wire of diameter 0.2 mm and resistance 7 \\u03a9 has resistivity 8.8 \\u00d7 10\\u207b\\u2077 \\u03a9 m. Calculate its length (\\u03c0 = 22/7).\"}], \"source_as_printed\": \"WASSCE (SC) 2018, Physics Paper 3, Question 3B\", \"title_as_printed\": \"3B. Ohm's law (V\\u2013I)\"}",
