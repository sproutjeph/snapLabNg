#!/usr/bin/env bash
# Git commit-msg hook: rejects AI attribution in any commit message, however
# the commit was made (Claude Code, Gemini, an editor, or -F file).
# Enabled once per clone with: git config core.hooksPath .githooks
if grep -Eiq 'co-authored-by:.*(claude|anthropic|gemini|google)|noreply@anthropic\.com|generated (with|by) (\[)?(claude|gemini)|claude\.ai/code|claude-session:' "$1"; then
  echo "commit-msg: remove AI attribution lines (Co-Authored-By an AI, 'Generated with …', session links)." >&2
  exit 1
fi
exit 0
